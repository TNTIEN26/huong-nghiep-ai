# ============================================================
# CÁCH 1 (khuyên dùng): OpenRouter — key MIỄN PHÍ + model MIỄN PHÍ
# Tạo key tại: https://openrouter.ai/keys (đăng nhập Google là xong)
# ============================================================
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=your_openrouter_key_here

# Danh sách model miễn phí (đuôi ":free") ưu tiên, ngăn cách dấu phẩy.
# AI tự thử lần lượt; model nào rate-limit thì tự chuyển model kế tiếp.
# Xem danh sách model free hiện có tại: https://openrouter.ai/models?q=:free
OPENROUTER_MODEL=nex-agi/nex-n2.5-pro:free,nex-agi/nex-n2.5-mini:free,dots-studio/dots-3-note-preview:free,poolside/laguna-xs-2.1:free,google/gemma-4-26b-a4b-it:free

# ============================================================
# CÁCH 2 (dự phòng): Google Gemini
# Lấy key tại: https://aistudio.google.com/apikey
# Lưu ý: từ giữa 2026 Google cấp key dạng "AQ." mới và hiện có
# lỗi khiến nhiều key bị từ chối. Nếu Google khắc phục thì:
#   - đổi AI_PROVIDER=gemini
#   - điền GEMINI_API_KEY
# ============================================================
# AI_PROVIDER=gemini
# GEMINI_API_KEY=your_gemini_key_here
# GEMINI_MODEL=gemini-2.5-flash