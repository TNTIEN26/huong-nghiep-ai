# ============================================================
# CẤU HÌNH AI (Gemini-only)
# ============================================================
GEMINI_API_KEY=your_gemini_api_key_here
# Khóa dự phòng (account Google khác nhau) — tự xoay vòng khi key trước
# hết quota hoặc bị khóa. Để trống nếu chỉ dùng 1 key. Hỗ trợ tới 20 slot (_2.._20).
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
GEMINI_API_KEY_6=
GEMINI_API_KEY_7=
GEMINI_API_KEY_8=
GEMINI_API_KEY_9=
GEMINI_API_KEY_10=
# Cách khác: dán nhiều key vào một biến, phân tách bởi dấu phẩy
# (gộp chung với các slot ở trên, tự loại key trùng/lặp):
# GEMINI_API_KEYS=key1,key2,key3

GEMINI_MODEL=gemini-3.1-flash-lite
# Model dự phòng (cùng Gemini), phân tách bởi dấu phẩy — dùng khi model chính quá tải:
GEMINI_MODEL_FALLBACK=gemini-3.8-flash

# ============================================================
# Lưu log đánh giá (đề tài KHKT):
# - EVAL_STORE=file (mặc định): ghi vào data/.danh-gia/*.jsonl (chạy local).
# - EVAL_STORE=redis: ghi lên Upstash Redis (dùng khi deploy Vercel).
# ============================================================
EVAL_STORE=file
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Khóa truy xuất thống kê nội bộ:
THONG_KE_KEY=your_secret_key_here
