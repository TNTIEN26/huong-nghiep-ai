# ============================================================
# CÁCH 1 (khuyên dùng): OpenRouter — key MIỄN PHÍ + model MIỄN PHÍ
# Tạo key tại: https://openrouter.ai/keys (đăng nhập Google là xong)
# ============================================================
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=your_openrouter_key_here

# Danh sách model miễn phí (đuôi ":free") ưu tiên, ngăn cách dấu phẩy.
# AI tự thử lần lượt; model nào rate-limit thì tự chuyển model kế tiếp.
# Xem danh sách model free hiện có tại: https://openrouter.ai/models?q=:free
OPENROUTER_MODEL=dots-studio/dots-3-note-preview:free,qwen/qwen3.8-27b:free,google/gemma-4-26b-a4b-it:free,poolside/laguna-xs-2.1:free,liquid/lfm-2.5-2.6b:free

# ============================================================
# CÁCH 2 (dự phòng): Google Gemini
# Lấy key tại: https://aistudio.google.com/apikey
# Lưu ý: từ giữa 2026 Google cấp key dạng "AQ." mới và hiện có
# lỗi khiến nhiều key bị từ chối. Nếu Google khắc phục thì:
#   - đổi AI_PROVIDER=gemini
#   - điền GEMINI_API_KEY
# ============================================================
GEMINI_API_KEY=dan_key_gemini_cua_ban_o_day
GEMINI_MODEL=gemini-3.1-flash-lite

# ============================================================
# Lưu log đánh giá (đề tài KHKT):
# - EVAL_STORE=file (mặc định): ghi vào data/.danh-gia/*.jsonl (chạy local).
# - EVAL_STORE=redis: ghi lên Upstash Redis (dùng khi deploy Vercel,
#   nơi hệ thống tệp là read-only). Cần 2 biến bên dưới.
# ============================================================
EVAL_STORE=file
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ============================================================
# Khóa truy xuất thống kê nội bộ:
# GET /api/xuat-log chỉ mở khi kèm ?key=... hoặc header
# Authorization: Bearer ... trùng giá trị này. Sai/không cấu
# hình đều trả 403. Đặt chuỗi ngẫu nhiên dài, KHÔNG chia sẻ.
# ============================================================
THONG_KE_KEY=doi_key_ngau_nhien_dai_o_day
