# ============================================================
# CẤU HÌNH AI PROVIDER
# ============================================================
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite
# Model dự phòng (cùng Gemini), phân tách bởi dấu phẩy — dùng khi model chính quá tải:
GEMINI_MODEL_FALLBACK=gemini-3.8-flash

# Danh sách model OpenRouter dự phòng:
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free,inclusionai/ling-3.2-flash:free,nvidia/nemotron-3.5-lightning:free

# ============================================================
# Lưu log đánh giá (đề tài KHKT):
# - EVAL_STORE=file (mặc định): ghi vào data/.danh-gia/*.jsonl (chạy local).
# - EVAL_STORE=redis: ghi lên Upstash Redis (dùng khi deploy Vercel).
# ============================================================
EVAL_STORE=file
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Khóa truy xuất thống kê nội bộ:
THONG_KE_KEY=your_secret_key_here
